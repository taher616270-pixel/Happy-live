{
  "name": "happy-live-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "node scripts/deploy.mjs",
    "db:local": "wrangler d1 migrations apply happy-live-db --local",
    "db:remote": "wrangler d1 migrations apply happy-live-db --remote",
    "test": "node --test tests/*.test.mjs",
    "test:games": "node --test tests/game-api-contract.test.mjs tests/game-registry-contract.test.mjs tests/game-economy-sql.test.mjs",
    "dev:local": "wrangler dev --local --config wrangler.toml",
    "db:games:local": "wrangler d1 migrations apply happy-live-db --local --config wrangler.toml",
    "db:messaging:remote": "node scripts/apply-private-messaging.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "agora-token": "^2.0.7"
  }
}
