{
  "name": "happy-live-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply happy-live-db --local",
    "db:remote": "wrangler d1 migrations apply happy-live-db --remote",
    "db:preview:list": "wrangler d1 migrations list happy-live-room-exp-preview-db --remote --config wrangler.preview-migrations.toml",
    "db:preview": "wrangler d1 migrations apply happy-live-room-exp-preview-db --remote --config wrangler.preview-migrations.toml",
    "preview:deploy": "wrangler preview --name cat-greed",
    "preview:secrets:list": "wrangler preview secret list --name cat-greed",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "agora-token": "^2.0.7"
  }
}
